<UserControl x:Class="CineTrack.Views.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1a1a2e">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER (MATCH FAVORIS STYLE) -->
        <Border Grid.Row="0" Background="#16213e">

            <Grid Margin="20,0">

                <TextBlock Text="CineTrack"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Recherche avancée"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Button Content="Accueil"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding RetourCommand}"
                        Margin="0,0,20,0"/>
            </Grid>

        </Border>

        <!-- SEARCH -->
        <TextBox Grid.Row="1"
                 Height="35"
                 Width="300"
                 Background="#0f3460"
                 Foreground="White"
                 Padding="10,0"
                 HorizontalAlignment="Center"
                 Margin="0,10,0,0"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

        <!-- FILTERS -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10">

            <CheckBox Content="Airing"
                      Foreground="White"
                      Margin="0,0,20,0"
                      IsChecked="{Binding OnlyAiring}" />

            <TextBlock Text="Min eps:"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <TextBox Width="50"
                     Margin="5,0,15,0"
                     Background="#0f3460"
                     Foreground="White"
                     Text="{Binding MinEpisodes, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Max eps:"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <TextBox Width="50"
                     Margin="5,0,0,0"
                     Background="#0f3460"
                     Foreground="White"
                     Text="{Binding MaxEpisodes, UpdateSourceTrigger=PropertyChanged}" />

        </StackPanel>

        <!-- RESULTS -->
        <ScrollViewer Grid.Row="3">

            <ItemsControl ItemsSource="{Binding Results}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>

                        <Button Command="{Binding OpenCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="5">

                            <Border Width="150"
                                    Height="220"
                                    Background="#16213e"
                                    CornerRadius="8">

                                <Grid>

                                    <Image Source="{Binding ImageUrl}"
                                        Stretch="UniformToFill"/>

                                    <TextBlock Text="{Binding Title}"
                                        VerticalAlignment="Bottom"
                                        Foreground="White"
                                        Margin="8"
                                        TextWrapping="Wrap"/>

                                </Grid>

                            </Border>

                        </Button>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>
</UserControl>