<Window x:Class="CineTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CineTrack" Height="700" Width="900"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16213e">
            <Grid Margin="20,0">
                <TextBlock Text="CineTrack"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- Barre de recherche -->
                <TextBox Width="250"
                         Height="32"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Background="#0f3460"
                         Foreground="#888"
                         CaretBrush="White"
                         BorderBrush="#0f3460"
                         Padding="10,0"
                         Text="(FAKE BAR) Rechercher un anime..."/>

                <!-- Bouton login -->
                <Button Content="Se connecter"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnLogin_Click"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT - landing page -->
        <ScrollViewer x:Name="LandingPage"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">

                <!-- Titre principal -->
                <TextBlock Text="Découvrez les meilleurs animes"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Suivez, notez et partagez vos animes préférés"
                           Foreground="#888"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- 3 covers anime -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Anime 1 -->
                    <StackPanel Margin="10">
                        <Border Width="180" Height="260"
                                Background="#e94560"
                                CornerRadius="8"/>
                        <TextBlock Text="Anime 1"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Anime 2 -->
                    <StackPanel Margin="10">
                        <Border Width="180" Height="260"
                                Background="#0f3460"
                                CornerRadius="8"/>
                        <TextBlock Text="Anime 2"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Anime 3 -->
                    <StackPanel Margin="10">
                        <Border Width="180" Height="260"
                                Background="#16213e"
                                CornerRadius="8"/>
                        <TextBlock Text="Anime 3"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Frame pour navigation - cachée au départ -->
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Visibility="Collapsed"/>

    </Grid>
</Window>