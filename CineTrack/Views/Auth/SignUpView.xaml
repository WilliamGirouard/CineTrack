<UserControl x:Class="CineTrack.Views.Auth.SignUpView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:CineTrack.ViewModels.Auth"
      xmlns:conv="clr-namespace:CineTrack.Converters"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="500"
      d:DataContext="{d:DesignInstance Type=vm:SignUpViewModel}"
      Background="#1a1a2e">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisInverseConverter"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <conv:LoadingTextConverter x:Key="LoadingTextConverter"/>

        
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#1a3a6e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#e94560"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#0f3460"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1a3a6e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#e94560"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#c73652"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#333"/>
                                <Setter Property="Foreground" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#aaa"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,0,0,5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1"
                    Background="#16213e"
                    CornerRadius="16"
                    Padding="40,36"
                    Margin="60,30"
                    MaxWidth="440">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#000"/>
                </Border.Effect>

                <StackPanel>

                    
                    <TextBlock Text="CineTrack"
                               FontSize="28" FontWeight="Bold"
                               Foreground="#e94560"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Créer un compte"
                               FontSize="15" Foreground="#888"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    
                    <TextBlock Text="Nom complet" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Nom d'utilisateur" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,16"/>

                    
                    <TextBlock Text="Adresse courriel" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,16"/>

                    
                    <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,4">
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource PasswordStyle}"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     Visibility="{Binding IsPasswordVisible,
                                         Converter={StaticResource BoolToVisInverseConverter}}"/>
                        <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"
                                 Visibility="{Binding IsPasswordVisible,
                                     Converter={StaticResource BoolToVisConverter}}"/>
                        <Button Content="👁"
                                Width="36" Height="34"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding TogglePasswordVisibilityCommand}"
                                FontSize="15"/>
                    </Grid>
                    <TextBlock Text="Min. 10 caractères, 1 chiffre, 1 caractère spécial"
                               FontSize="11" Foreground="#555"
                               Margin="2,0,0,16"/>

                    
                    <TextBlock Text="Confirmer le mot de passe" Style="{StaticResource FieldLabel}"/>
                    <Grid Margin="0,0,0,24">
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource PasswordStyle}"
                                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                     Visibility="{Binding IsPasswordVisible,
                                         Converter={StaticResource BoolToVisInverseConverter}}"/>
                        <TextBox Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputStyle}"
                                 Visibility="{Binding IsPasswordVisible,
                                     Converter={StaticResource BoolToVisConverter}}"/>
                    </Grid>

                    
                    <Border Background="#3d1a24"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,0,16"
                            Visibility="{Binding ErrorMessage,
                                Converter={StaticResource StringToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#e94560"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding SignUpCommand}"
                            Margin="0,0,0,20">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}">
                                        <Binding Path="IsLoading"
                                                 Converter="{StaticResource LoadingTextConverter}"
                                                 ConverterParameter="S'inscrire"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Déjà un compte ? "
                                   Foreground="#888" FontSize="13"/>
                        <TextBlock Text="Se connecter"
                                   Foreground="#e94560" FontSize="13"
                                   Cursor="Hand"
                                   TextDecorations="Underline">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding NavigateToSignInCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
