<UserControl x:Class="CineTrack.Views.Auth.Verification.EmailVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="#1a1a2e">

    <StackPanel Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBlock Text="Vérification du compte"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <TextBlock Text="{Binding UserEmail, StringFormat='Code envoyé à : {0}'}"
                   Foreground="#888"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24"/>

        <TextBox Text="{Binding VerificationCode, UpdateSourceTrigger=PropertyChanged}"
                 Background="#16213e"
                 Foreground="White"
                 BorderThickness="0"
                 Padding="12"
                 FontSize="18"
                 TextAlignment="Center"
                 MaxLength="6"
                 Margin="0,0,0,12"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#e94560"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <TextBlock Text="{Binding SuccessMessage}"
                   Foreground="#4CAF50"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <Button Content="Vérifier"
                Command="{Binding VerifyCodeCommand}"
                Background="#e94560"
                Foreground="White"
                BorderThickness="0"
                Padding="12,8"
                Cursor="Hand"
                Margin="0,0,0,8"/>

        <Button Content="Renvoyer le code"
                Command="{Binding ResendCodeCommand}"
                Background="Transparent"
                Foreground="#888"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,0,0,8"/>

        <Button Content="← Retour au profil"
                Command="{Binding GoBackCommand}"
                Background="Transparent"
                Foreground="#e94560"
                BorderThickness="0"
                Cursor="Hand"/>

    </StackPanel>
</UserControl>