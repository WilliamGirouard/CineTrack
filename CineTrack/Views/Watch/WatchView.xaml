<UserControl x:Class="CineTrack.Views.Watch.WatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0d0d0d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#111">
            <Grid Margin="20,0">
                <Button Content="← Retour"
                        Width="90" Height="34"
                        HorizontalAlignment="Left"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding GoBackCommand}"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding EpisodeNumber, StringFormat='Épisode {0}'}"
                               Foreground="#888" FontSize="12"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- VIDEO SIMULÉ -->
        <Grid Grid.Row="1" Background="#000">

            <Image x:Name="VideoImage"
                   Source="{Binding ImageUrl, TargetNullValue={x:Null}}"
                   Stretch="Uniform"
                   Opacity="0.35"/>

            <!-- Bouton play/pause au centre -->
            <Border Background="#33000000"
                    Width="80" Height="80"
                    CornerRadius="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding TogglePlayCommand}"/>
                </Border.InputBindings>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="36"
                           Foreground="White">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="▶"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Text" Value="⏸"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <TextBlock Text="SIMULATION — Aucune vidéo réelle"
                       Foreground="#444" FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,12"/>
        </Grid>

        <!-- CONTROLS -->
        <Border Grid.Row="2" Background="#111" Padding="30,16">
            <StackPanel>

                <!-- Barre de progression -->
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{Binding CurrentTime}"
                               Foreground="#888" FontSize="11"
                               HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding TotalTime}"
                               Foreground="#888" FontSize="11"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Slider Value="{Binding Progress}"
                        Minimum="0" Maximum="100"
                        Margin="0,0,0,14"/>

                <!-- Boutons de navigation entre épisodes -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <Button Width="110" Height="36"
                            Margin="0,0,12,0"
                            Background="#0f3460"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding PreviousEpisodeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏮  " VerticalAlignment="Center"/>
                            <TextBlock Text="Ép. préc." VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Width="56" Height="56"
                            Background="#e94560"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding TogglePlayCommand}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="20">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="▶"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="⏸"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Button Width="110" Height="36"
                            Margin="12,0,0,0"
                            Background="#0f3460"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding NextEpisodeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Ép. suiv." VerticalAlignment="Center"/>
                            <TextBlock Text="  ⏭" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>