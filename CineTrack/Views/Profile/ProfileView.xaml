<UserControl x:Class="CineTrack.Views.Profile.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900"
             Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0"
                Background="#16213e">
            <Grid Margin="20,0">
                <Button Content="← Retour"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        Foreground="#e94560"
                        BorderThickness="0"
                        FontSize="14"
                        Cursor="Hand"
                        Command="{Binding GoBackCommand}"/>

                <TextBlock Text="Profil"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- loading -->
        <TextBlock Grid.Row="1"
                   Text="Chargement..."
                   Foreground="#888"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- body -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisInverseConverter}}">

            <StackPanel Margin="40,30">

                <!-- header -->
                <Border Background="#16213e"
                        CornerRadius="12"
                        Padding="30,24"
                        Margin="0,0,0,28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <!-- profile -->
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="52"
                                        Height="52"
                                        CornerRadius="26"
                                        Background="#e94560"
                                        Margin="0,0,16,0">
                                    <TextBlock Text="{Binding UsernameInitial}"
                                               Foreground="White"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username}"
                                               Foreground="White"
                                               FontSize="24"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding MemberSince, StringFormat='Membre depuis {0}'}"
                                               Foreground="#888"
                                               FontSize="13"
                                               Margin="0,3,0,0"/>

                                    <TextBlock Text="{Binding VerificationMessage}"
                                               FontSize="13"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding IsOwnProfile, Converter={StaticResource BoolToVisConverter}}">      
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                        <Setter Property="Foreground" Value="LightGreen"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Content="Vérifier mon compte"
                                                Command="{Binding VerifyAccountCommand}"
                                                Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisInverseConverter}}"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                Padding="12,6"
                                                Background="#e94560"
                                                Foreground="White"
                                                Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- favoris -->
                <StackPanel Visibility="{Binding IsOwnProfile, Converter={StaticResource BoolToVisConverter}}"
                            Margin="0,0,0,36">

                    <TextBlock Text="Mes favoris"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,14"/>

                    <!-- vide -->
                    <TextBlock Text="Aucun favori pour l'instant."
                               Foreground="#888"
                               FontSize="14"
                               Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FavorisList.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding FavorisList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectAnimeCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        IsTabStop="False">
                                    <Border Width="150"
                                            Height="220"
                                            Margin="0,0,12,12"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="#16213e">
                                        <Grid>
                                            <Image Source="{Binding ImageUrl}"
                                                   Stretch="UniformToFill"/>
                                            <Border VerticalAlignment="Bottom"
                                                    CornerRadius="0,0,8,8">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="0,1">
                                                        <GradientStop Color="Transparent"
                                                                      Offset="0"/>
                                                        <GradientStop Color="#EE000000"
                                                                      Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="40"
                                                           Margin="8,4"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- notes -->
                <TextBlock Text="Évaluations"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,14"/>

                <!-- vide -->
                <TextBlock Text="Aucune évaluation pour l'instant."
                           Foreground="#888"
                           FontSize="14"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility"
                                    Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RatingsList.Count}"
                                             Value="0">
                                    <Setter Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding RatingsList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding OpenCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    IsTabStop="False">
                                <!-- Anime -->
                                <Border Width="150"
                                        Height="268"
                                        Margin="0,0,12,12"
                                        CornerRadius="8"
                                        Background="#16213e"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="200"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- image -->
                                        <Image Grid.Row="0"
                                               Source="{Binding ImageUrl}"
                                               Stretch="UniformToFill"/>

                                        <!-- titre + score -->
                                        <StackPanel Grid.Row="1"
                                                    Margin="8,6,8,8"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="32"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RatingDisplay}"
                                                       Foreground="#f0c040"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
