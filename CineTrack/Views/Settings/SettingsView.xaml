<UserControl x:Class="CineTrack.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CineTrack.ViewModels.Settings"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Background="#1a1a2e">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16213e">
            <Grid Margin="20,0">

                <TextBlock Text="CineTrack"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Paramètres"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Content="Accueil"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding GoBackCommand}"
                        Margin="0,0,20,0"/>
            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40,24,40,40" MaxWidth="540">

                <!-- Mon profil -->
                <Border Background="#16213e" CornerRadius="10" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="MON PROFIL"
                                   Foreground="#e94560" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Nom complet" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding DisplayFullName}" Foreground="White" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Nom d'utilisateur" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding DisplayUsername}" Foreground="White" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Adresse e-mail" Foreground="#888" FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding DisplayEmail}" Foreground="White" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Mot de passe -->
                <Border Background="#16213e" CornerRadius="10" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="MOT DE PASSE"
                                   Foreground="#e94560" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Vous serez redirigé vers le formulaire de changement de mot de passe."
                                   Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Button Content="Changer le mot de passe"
                                Height="34" Padding="18,0"
                                HorizontalAlignment="Left"
                                Background="#e94560" Foreground="White"
                                BorderThickness="0" Cursor="Hand" FontSize="13"
                                Command="{Binding ChangePasswordCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Changer l'adresse e-mail -->
                <Border Background="#16213e" CornerRadius="10" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CHANGER L'ADRESSE E-MAIL"
                                   Foreground="#e94560" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Nouvelle adresse e-mail" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Background="#0f3460" Foreground="White" CaretBrush="White"
                                 BorderBrush="#0f3460" BorderThickness="1"
                                 Padding="10,6" Height="34" FontSize="13" Margin="0,0,0,10"
                                 Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Modifier l'adresse e-mail"
                                Height="34" Padding="18,0"
                                HorizontalAlignment="Left"
                                Background="#e94560" Foreground="White"
                                BorderThickness="0" Cursor="Hand" FontSize="13"
                                Command="{Binding ChangeEmailCommand}"/>

                        <TextBlock Text="{Binding EmailMessage}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding EmailMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EmailSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#4caf50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding EmailSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="#e94560"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Changer le nom d'utilisateur -->
                <Border Background="#16213e" CornerRadius="10" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CHANGER LE NOM D'UTILISATEUR"
                                   Foreground="#e94560" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Nouveau nom d'utilisateur" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox Background="#0f3460" Foreground="White" CaretBrush="White"
                                 BorderBrush="#0f3460" BorderThickness="1"
                                 Padding="10,6" Height="34" FontSize="13" Margin="0,0,0,10"
                                 Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Modifier le nom d'utilisateur"
                                Height="34" Padding="18,0"
                                HorizontalAlignment="Left"
                                Background="#e94560" Foreground="White"
                                BorderThickness="0" Cursor="Hand" FontSize="13"
                                Command="{Binding ChangeUsernameCommand}"/>

                        <TextBlock Text="{Binding UsernameMessage}"
                                   FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding UsernameMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsernameSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#4caf50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UsernameSuccess}" Value="False">
                                            <Setter Property="Foreground" Value="#e94560"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Zone danger -->
                <Border Background="#16213e" CornerRadius="10" Padding="24,20"
                        BorderBrush="#7b1d2e" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="ZONE DANGER"
                                   Foreground="#e94560" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="La suppression de votre compte est définitive. Toutes vos données seront perdues."
                                   Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Button Content="Supprimer mon compte"
                                Height="34" Padding="18,0"
                                HorizontalAlignment="Left"
                                Background="#7b1d2e" Foreground="#ffaaaa"
                                BorderThickness="0" Cursor="Hand" FontSize="13"
                                Command="{Binding DeleteAccountCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
