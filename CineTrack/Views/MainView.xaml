<UserControl x:Class="CineTrack.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CineTrack.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#1a1a2e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16213e">
            <Grid Margin="20,0">
                <TextBlock Text="CineTrack"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <!-- Barre de recherche -->
                <Border Width="250"
                        Height="32"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#0f3460"
                        CornerRadius="8" 
                        BorderBrush="#1a3a6e"
                        BorderThickness="1">
                    <TextBox Background="Transparent"
                             Foreground="#888"
                             CaretBrush="White"
                             BorderThickness="0"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             Text="Rechercher un anime..."/>
                </Border>

                <!-- Bouton favoris -->
                <Button Content="Mes favoris"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Margin="0,0,125,0"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding FavorisCommand}"/>

                <!-- Bouton disconnect -->
                <Button Content="Se déconnecter"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding DisconnectCommand}"/>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer x:Name="LandingPage"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">

                <TextBlock Text="Découvrez les meilleurs animes"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Suivez, notez et partagez vos animes préférés"
                           Foreground="#888"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- 3 covers anime -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                    <!-- Anime 1 -->
                    <StackPanel Margin="10">
                        <Border Width="180" Height="260"
                                Background="#e94560"
                                CornerRadius="8"/>
                        <TextBlock Text="Anime 1"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,2"/>
                        <TextBlock Text="Description courte"
                                   Foreground="#888"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Anime 2 -->
                    <StackPanel Margin="10">
                        <Border Width="180" Height="260"
                                Background="#0f3460"
                                CornerRadius="8"/>
                        <TextBlock Text="Anime 2"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,2"/>
                        <TextBlock Text="Description courte"
                                   Foreground="#888"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Anime 3 -->
                    <StackPanel Margin="10">
                        <Border Width="180" Height="260"
                                Background="#16213e"
                                CornerRadius="8"/>
                        <TextBlock Text="Anime 3"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,2"/>
                        <TextBlock Text="Description courte"
                                   Foreground="#888"
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>