<UserControl x:Class="CineTrack.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CineTrack.Views"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="#1a1a2e"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16213e">
            <Grid Margin="20,0">
                <TextBlock Text="CineTrack"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBox Width="250"
                         Height="32"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Background="#0f3460"
                         Foreground="#888"
                         CaretBrush="White"
                         BorderBrush="#0f3460"
                         Padding="10,0"
                         Text="(FAKE BAR) Rechercher un anime..."/>

                <Button Content="Mes favoris"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Margin="0,0,125,0"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding FavorisCommand}"/>

                <Button Content="Se deconnecter"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding DisconnectCommand}"/>
            </Grid>
        </Border>

        <!-- LOADING -->
        <TextBlock Grid.Row="1"
                   Text="Chargement..."
                   Foreground="#888"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- CAROUSELS -->
        <ScrollViewer x:Name="LandingPage"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisInverseConverter}}">
            <StackPanel Margin="0,30">

                <TextBlock Text="Découvrez les meilleurs animes"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Suivez, notez et partagez vos animes préférés"
                           Foreground="#888"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <ItemsControl ItemsSource="{Binding Carousels}" Margin="20,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,30">

                                <!-- Carousel title -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding GenreName}"
                                               FontSize="20"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GenreName}" Value="Trending">
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text=" — chargement..."
                                               Foreground="#888"
                                               FontSize="14"
                                               VerticalAlignment="Bottom"
                                               Margin="8,0,0,2"
                                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>
                                </StackPanel>

                                <!-- Carousel row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="❮"
                                            Command="{Binding PreviousCommand}"
                                            Width="32" Height="32"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Background="#0f3460"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="14"
                                            Cursor="Hand"/>

                                    <ScrollViewer Grid.Column="1"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  SizeChanged="CardsPanel_SizeChanged">
                                        <ItemsControl HorizontalAlignment="Center"
                                                      ItemsSource="{Binding VisibleAnimes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding SelectAnimeCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            IsTabStop="False"
                                                            ClickMode="Release">
                                                        <Border Width="150" Height="220"
                                                                Margin="6,0"
                                                                CornerRadius="8"
                                                                ClipToBounds="True"
                                                                Background="#16213e">
                                                            <Grid>
                                                                <Image Source="{Binding ImageUrl}"
                                                                       Stretch="UniformToFill"/>

                                                                <!-- Gradient + titre + score -->
                                                                <Border VerticalAlignment="Bottom"
                                                                        CornerRadius="0,0,8,8">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="Transparent" Offset="0"/>
                                                                            <GradientStop Color="#EE000000" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <StackPanel>
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Margin" Value="8,4"/>
                                                                                <Style.Triggers>
                                                                                    <!-- Décale le texte à droite quand le rank est affiché -->
                                                                                    <DataTrigger Binding="{Binding Rank}" Value="0">
                                                                                        <Setter Property="Margin" Value="8,4"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   Foreground="White"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxHeight="36"/>
                                                                        <TextBlock Text="{Binding CommunityScoreDisplay}"
                                                                                   Foreground="#f0c040"
                                                                                   FontSize="10"
                                                                                   Margin="0,2,0,4"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Rank — Collapsed si Rank = 0 (non-trending) -->
                                                                <TextBlock Text="{Binding Rank, StringFormat='{}{0:00}'}"
                                                                           Foreground="#e94560"
                                                                           FontSize="38"
                                                                           FontWeight="Black"
                                                                           VerticalAlignment="Top"
                                                                           HorizontalAlignment="Left"
                                                                           Margin="5,0,0,-8">
                                                                    <TextBlock.Effect>
                                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="2" Color="Black"/>
                                                                    </TextBlock.Effect>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowRank}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>

                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <Button Grid.Column="2"
                                            Content="❯"
                                            Command="{Binding NextCommand}"
                                            Width="32" Height="32"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Background="#0f3460"
                                            Foreground="White"
                                            BorderThickness="0"
                                            FontSize="14"
                                            Cursor="Hand"/>
                                </Grid>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>