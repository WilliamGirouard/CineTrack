<UserControl x:Class="CineTrack.Views.AnimeDetails.AnimeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CineTrack.ViewModels.AnimeDetails"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:AnimeDetailsViewModel}"
             Background="#1a1a2e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16213e">
            <Grid Margin="20,0">
                <Button Content="← Retour"
                        Width="90" Height="34"
                        HorizontalAlignment="Left"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding GoBackCommand}"/>
                <TextBlock Text="{Binding Title}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- LOADING -->
        <TextBlock Grid.Row="1"
                   Text="Chargement..."
                   Foreground="#888"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisInverseConverter}}">
            <Grid Margin="40,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Cover + badges -->
                <StackPanel Grid.Column="0" Margin="0,0,30,0">

                    <!-- Cover image -->
                    <Border CornerRadius="10"
                            ClipToBounds="True"
                            Width="220" Height="320">
                        <Image Source="{Binding ImageUrl}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- MAL Score -->
                    <Border Background="#16213e"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Global Rating"
                                       Foreground="#888"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding JikanScore}"
                                       Foreground="#f0c040"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Community score -->
                    <Border Background="#16213e"
                            CornerRadius="8"
                            Margin="0,16,0,0"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="CineTrack Community Rating"
                                       Foreground="#888"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CommunityScoreDisplay}"
                                       Foreground="#f0c040"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    

                    <!-- User rating -->
                    <Border Background="#16213e"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="YOUR RATING"
                                       Foreground="#888"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content="1"
                                        Command="{Binding RateCommand}"
                                        CommandParameter="1"
                                        Width="36" Height="36" Margin="2,0"
                                        FontSize="13" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"
                                        Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#0f3460"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserRating}" Value="1">
                                                    <Setter Property="Background" Value="#e94560"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="2"
                                        Command="{Binding RateCommand}"
                                        CommandParameter="2"
                                        Width="36" Height="36" Margin="2,0"
                                        FontSize="13" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"
                                        Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#0f3460"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserRating}" Value="2">
                                                    <Setter Property="Background" Value="#e94560"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="3"
                                        Command="{Binding RateCommand}"
                                        CommandParameter="3"
                                        Width="36" Height="36" Margin="2,0"
                                        FontSize="13" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"
                                        Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#0f3460"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserRating}" Value="3">
                                                    <Setter Property="Background" Value="#e94560"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="4"
                                        Command="{Binding RateCommand}"
                                        CommandParameter="4"
                                        Width="36" Height="36" Margin="2,0"
                                        FontSize="13" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"
                                        Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#0f3460"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserRating}" Value="4">
                                                    <Setter Property="Background" Value="#e94560"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="5"
                                        Command="{Binding RateCommand}"
                                        CommandParameter="5"
                                        Width="36" Height="36" Margin="2,0"
                                        FontSize="13" FontWeight="Bold"
                                        BorderThickness="0" Cursor="Hand"
                                        Foreground="White">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#0f3460"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UserRating}" Value="5">
                                                    <Setter Property="Background" Value="#e94560"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Favorite -->
                    <Border CornerRadius="8"
                            Margin="0,10,0,0"
                            ClipToBounds="True">
                        <Button Command="{Binding ToggleFavoriteCommand}"
                                Background="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="12,10">
                            <TextBlock Text="{Binding FavoriteButtonText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                        </Button>
                    </Border>

                    <!-- Episode count badge -->
                    <Border Background="#0f3460"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📺  "
                                       Foreground="White"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Episodes}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Age rating badge -->
                    <Border Background="#e94560"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🔞  "
                                       Foreground="White"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AgeRating}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT: Title + description -->
                <StackPanel Grid.Column="1">

                    <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <!-- Divider -->
                    <Border Height="2"
                            Background="#e94560"
                            HorizontalAlignment="Left"
                            Width="60"
                            Margin="0,0,0,20"/>

                    <TextBlock Text="SYNOPSIS"
                               Foreground="#888"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding Desc}"
                               Foreground="#ccc"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="24"/>
                    <!-- ÉPISODES -->
                    <Border Height="2"
                            Background="#e94560"
                            HorizontalAlignment="Left"
                            Width="60"
                            Margin="0,30,0,20"/>

                    <TextBlock Text="ÉPISODES"
                               Foreground="#888"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <ListBox ItemsSource="{Binding EpisodeList}"
                             Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVisConverter}}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="300">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding StringFormat='Ép. {0}'}"
                                        Width="80" Height="34"
                                        Margin="5"
                                        Background="#0f3460"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.WatchEpisodeDetailsCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock 
                        Text="Nombre d'épisodes inconnu (série en cours)"
                        Foreground="#888"
                        FontSize="13"
                        Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVisInverseConverter}}"/>
                    <StackPanel 
                        Orientation="Horizontal"
                        Visibility="{Binding HasEpisodes, Converter={StaticResource BoolToVisConverter}}"
                        HorizontalAlignment="Center" 
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Margin="0,8,0,16">
                        <Button 
                            Content="◀"
                            Command="{Binding PreviousEpisodePageCommand}"
                            Width="36" Height="36"
                            Background="#e94560"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentEpisodePage, StringFormat='Page {0}'}"
                            Foreground="White"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalEpisodePages, StringFormat='/ {0}'}"
                            Foreground="#888"
                            VerticalAlignment="Center"/>
                        <Button Content="▶"
                            Command="{Binding NextEpisodePageCommand}"
                            Width="36" Height="36"
                            Background="#e94560"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="8,0,0,0"/>
                    </StackPanel>
                    
                    <!-- COMMENTS SECTION -->
                    <Border Height="2"
                            Background="#e94560"
                            HorizontalAlignment="Left"
                            Width="60"
                            Margin="0,30,0,20"/>

                    <TextBlock Text="COMMENTAIRES"
                               Foreground="#888"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,16"/>

                    <!-- DELETE all comments(Admin)-->
                    <Button Content="🗑️ Supprimer tous les commentaires"
                            Command="{Binding DeleteAllCommentsCommand}"
                            Visibility="{Binding IsCurrentUserAdmin, Converter={StaticResource BoolToVisConverter}}"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,12"
                            Padding="14,8"
                            Background="#e94560"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand">
                    </Button>

                    <!-- Add comment box -->
                    <Border Background="#16213e"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0f3460"
                                     Foreground="White"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     Padding="10"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Height="80"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top">
                                <TextBox.Resources>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <Button Content="Ajouter un commentaire ✍️"
                                    Command="{Binding AddCommentsCommand}"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0"
                                    Padding="16,8"
                                    Background="#e94560"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Comments list -->
                    <ItemsControl ItemsSource="{Binding Commentaires}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#16213e"
                                        CornerRadius="8"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top: username + date + delete button -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤 "
                                                           Foreground="#e94560"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Username}"
                                                           Foreground="#e94560"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text=" · "
                                                           Foreground="#555"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DateCreation, StringFormat='{}{0:dd MMM yyyy}'}"
                                                           Foreground="#555"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RatingDisplay}"
                                                           Foreground="#f0c040"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"
                                                           Visibility="{Binding RatingDisplay, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                                            </StackPanel>

                                            <!-- Delete button (only if author OR ADMIN UPDATE) -->
                                            <Button Content="🗑️"
                                                    HorizontalAlignment="Right"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    FontSize="14"
                                                    Command="{Binding DataContext.DeleteCommentsCommand, 
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanDelete, 
                                                                 Converter={StaticResource BoolToVisConverter}}"/>
                                        </Grid>

                                        <!-- Comment text -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Texte}"
                                                   Foreground="#ccc"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>