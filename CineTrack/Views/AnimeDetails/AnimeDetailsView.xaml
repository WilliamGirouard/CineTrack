<UserControl x:Class="CineTrack.Views.AnimeDetails.AnimeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:CineTrack.ViewModels.AnimeDetails"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:AnimeDetailsViewModel}"
             Background="#1a1a2e"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16213e">
            <Grid Margin="20,0">
                <Button Content="← Retour"
                        Width="90" Height="34"
                        HorizontalAlignment="Left"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding GoBackCommand}"/>
                <TextBlock Text="{Binding Title}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- LOADING -->
        <TextBlock Grid.Row="1"
                   Text="Chargement..."
                   Foreground="#888"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisInverseConverter}}">
            <Grid Margin="40,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Cover + badges -->
                <StackPanel Grid.Column="0" Margin="0,0,30,0">

                    <!-- Cover image -->
                    <Border CornerRadius="10"
                            ClipToBounds="True"
                            Width="220" Height="320">
                        <Image Source="{Binding ImageUrl}"
                               Stretch="UniformToFill"/>
                    </Border>

                    <!-- Community score -->
                    <Border Background="#16213e"
                            CornerRadius="8"
                            Margin="0,16,0,0"
                            Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="COMMUNITY SCORE"
                                       Foreground="#888"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CommunityScoreDisplay}"
                                       Foreground="#f0c040"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Favorite -->
                    <Button Command="{Binding ToggleFavoriteCommand}"
                        Width="160"
                        Height="36"
                        Margin="0,10,0,0"
                        Background="{Binding IsFavorite, Converter={StaticResource FavoriteColorConverter}}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand">

                        <TextBlock Text="{Binding FavoriteButtonText}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"/>
                    </Button>

                    <!-- Episode count badge -->
                    <Border Background="#0f3460"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="📺  "
                                       Foreground="White"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Episodes}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Age rating badge -->
                    <Border Background="#e94560"
                            CornerRadius="8"
                            Margin="0,10,0,0"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="🔞  "
                                       Foreground="White"
                                       FontSize="13"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AgeRating}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT: Title + description -->
                <StackPanel Grid.Column="1">

                    <TextBlock Text="{Binding Title}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <!-- Divider -->
                    <Border Height="2"
                            Background="#e94560"
                            HorizontalAlignment="Left"
                            Width="60"
                            Margin="0,0,0,20"/>

                    <TextBlock Text="SYNOPSIS"
                               Foreground="#888"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding Desc}"
                               Foreground="#ccc"
                               FontSize="14"
                               TextWrapping="Wrap"
                               LineHeight="24"/>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>