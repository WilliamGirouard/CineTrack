<UserControl x:Class="CineTrack.Views.Favoris.FavorisView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:CineTrack.ViewModels.Favoris"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="500"
      d:DataContext="{d:DesignInstance Type=vm:FavorisViewModel}"
      Background="#1a1a2e">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#16213e">
            <Grid Margin="20,0">

                <TextBlock Text="CineTrack"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Mes Favoris"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Button Content="Accueil"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding RetourCommand}"/>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1">

            <!-- EMPTY STATE -->
            <TextBlock Text="Aucun favori pour l'instant."
                       Foreground="White"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FavorisList.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- LIST -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding FavorisList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding SelectAnimeCommand}"
                    Background="Transparent"
                    BorderThickness="0">

                                <Border Width="150"
                        Height="220"
                        Margin="6"
                        CornerRadius="8"
                        Background="#16213e">

                                    <Grid>

                                        <Image Source="{Binding ImageUrl}"
                               Stretch="UniformToFill"/>

                                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Bottom"
                                   Foreground="White"
                                   Margin="8"/>
                                    </Grid>

                                </Border>

                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>
</UserControl>