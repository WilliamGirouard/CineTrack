<UserControl x:Class="CineTrack.Views.Favoris.FavorisView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:CineTrack.ViewModels.Favoris"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="500"
      d:DataContext="{d:DesignInstance Type=vm:FavorisViewModel}"
      Background="#1a1a2e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#16213e">
            <Grid Margin="20,0">
                <TextBlock Text="CineTrack"
                           Foreground="#e94560"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock 
                   Text="Mes Favoris"
                   Foreground="#e94560"
                   FontSize="22"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Bouton favoris -->
        <Button Content="Page d'accueil"
                        Width="110"
                        Height="34"
                    
                        HorizontalAlignment="Right"
                        Background="#e94560"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Command="{Binding RetourCommand}" Margin="378,13,0,13"/>

        <TextBlock Grid.Row="1"
                   Text="Aucun favori pour l'instant."
                   Foreground="White" FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Visible"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FavorisList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#16213e"
                                Padding="10" Margin="8" Width="160">
                            <StackPanel>
                                <Image Source="{Binding ImageUrl}"
                                       Height="210" Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding TitreAnime}"
                                           Foreground="White" 
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" 
                                           Margin="0,8,0,2"
                                           TextAlignment="Center"/>
                                <Button Content="Retirer"
                                        Margin="0,8,0,0" 
                                        Height="28"
                                        Background="#e94560" 
                                        Foreground="White"
                                        BorderThickness="0" 
                                        Cursor="Hand"
                                        Command="{Binding DataContext.RemoveFavorisCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>