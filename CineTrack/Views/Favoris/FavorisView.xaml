<UserControl x:Class="CineTrack.Views.Favoris.FavorisView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:CineTrack.ViewModels.Favoris"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="500"
      d:DataContext="{d:DesignInstance Type=vm:FavorisViewModel}"
      Background="#1a1a2e">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mes Favoris"
                   FontSize="22" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1"
                   Text="Aucun favori pour l'instant."
                   Foreground="#888" FontSize="14"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FavorisList.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding FavorisList}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#16213e" CornerRadius="8"
                                Padding="10" Margin="8" Width="150">
                            <StackPanel>
                                <Image Source="{Binding ImageUrl}"
                                       Height="200" Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding TitreAnime}"
                                           Foreground="White" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           TextAlignment="Center"/>
                                <Button Content="Retirer"
                                        Margin="0,8,0,0" Height="28"
                                        Background="#e94560" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"
                                        Command="{Binding DataContext.RemoveFavorisCommand,
                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>