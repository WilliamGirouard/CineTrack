<Application x:Class="CineTrack.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CineTrack.Converters"
             xmlns:authVm="clr-namespace:CineTrack.ViewModels.Auth"
             xmlns:authV="clr-namespace:CineTrack.Views.Auth"
             xmlns:vm="clr-namespace:CineTrack.ViewModels"
             xmlns:favorisV="clr-namespace:CineTrack.Views.Favoris"
             xmlns:favorisVm="clr-namespace:CineTrack.ViewModels.Favoris"
             xmlns:detailVm="clr-namespace:CineTrack.ViewModels.AnimeDetails"
             xmlns:detailV="clr-namespace:CineTrack.Views.AnimeDetails"
             xmlns:v="clr-namespace:CineTrack.Views">
    <Application.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVisConverter"/>
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisInverseConverter"/>
        <conv:StringToVisibilityConverter      x:Key="StringToVisConverter"/>
        <conv:LoadingTextConverter             x:Key="LoadingTextConverter"/>

        <DataTemplate DataType="{x:Type authVm:SignInViewModel}">
            <authV:SignInView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:SignUpViewModel}">
            <authV:SignUpView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type favorisVm:FavorisViewModel}">
            <favorisV:FavorisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <v:MainView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type detailVm:AnimeDetailsViewModel}">
            <detailV:AnimeDetailsView/>
        </DataTemplate>

    </Application.Resources>
</Application>
