<Application x:Class="CineTrack.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CineTrack.Converters">
    <Application.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVisConverter"/>
        <conv:BoolToVisibilityInverseConverter x:Key="BoolToVisInverseConverter"/>
        <conv:StringToVisibilityConverter      x:Key="StringToVisConverter"/>
        <conv:LoadingTextConverter             x:Key="LoadingTextConverter"/>
    </Application.Resources>
</Application>
